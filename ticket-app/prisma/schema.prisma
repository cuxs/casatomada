generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  sales     Sale[]
  ridePosts RidePost[]

  @@index([active])
}

model Sale {
  id          String    @id @default(uuid())
  buyerName   String
  price       Int
  qrToken     String    @unique
  codeWord    String    @unique
  ticketCount Int       @default(1)
  used        Boolean   @default(false)
  usedAt      DateTime?
  outdated    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  guardarropaChecks GuardarropaCheck[]

  @@index([createdAt])
  @@index([eventId])
}

model GuardarropaCheck {
  id          String    @id @default(uuid())
  saleId      String
  sale        Sale      @relation(fields: [saleId], references: [id])
  itemCount   Int
  description String    @default("")
  createdAt   DateTime  @default(now())
  retrievedAt DateTime?

  @@index([saleId, retrievedAt])
}

model RidePost {
  id         String   @id @default(uuid())
  authorName String
  content    String
  phone      String?
  createdAt  DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  @@index([eventId])
}
